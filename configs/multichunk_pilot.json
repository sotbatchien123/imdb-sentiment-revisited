{
  "dataset": "data/processed/imdb_full_v1",
  "encoder": "checkpoints/bert-base-uncased",
  "output": "work_dirs/multichunk_v1",
  "batch_size": 2,
  "gradient_accumulation": 16,
  "chunk_microbatch": 4,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "dropout": 0.5,
  "lstm_hidden_size": 768,
  "max_epochs": 50,
  "early_stopping": false,
  "seeds_if_gate_passes": [42, 43, 44],
  "gate_min_delta_f1": 0.005,
  "encoder_frozen": true,
  "encoder_eval_mode": true,
  "encoder_precision": "bfloat16",
  "head_precision": "float32",
  "aggregation": "mean_chunk_representation",
  "content_tokens_per_chunk": 254,
  "test_policy": "No test access in pilot or validation-gated seed extension"
}
