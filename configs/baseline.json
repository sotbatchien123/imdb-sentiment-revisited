{
  "dataset": "data/processed/imdb_horror_movies_v1",
  "encoder": "checkpoints/bert-base-uncased",
  "output": "work_dirs/horror_frozen_bert_v1",
  "max_length": 256,
  "batch_size": 8,
  "gradient_accumulation": 4,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "dropout": 0.5,
  "lstm_hidden_size": 768,
  "max_epochs": 10,
  "patience": 2,
  "seeds": [42, 43, 44],
  "models": ["cls", "bilstm"],
  "encoder_frozen": true,
  "encoder_eval_mode": true,
  "encoder_precision": "bfloat16",
  "head_precision": "float32"
}
